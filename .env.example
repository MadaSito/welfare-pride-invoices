# Welfare Pride Invoices — production environment template
# Copy to .env only for local/VPS/Docker use. In Hostinger Web App Hosting,
# add these values in hPanel Environment Variables instead; never commit this file with real values.

NODE_ENV=production
# Hostinger supplies PORT. Set only for VPS/Docker local binding.
PORT=3000
# Native VPS deployments bind to 127.0.0.1 behind Nginx; Docker overrides this to 0.0.0.0 inside its container.
BIND_HOST=127.0.0.1
APP_ORIGIN=https://invoices.example.com
FORCE_SECURE_COOKIES=true
# Set true behind Nginx; the VPS bootstrap configures a Cloudflare-aware Nginx proxy by default.
TRUST_PROXY=true
# Documentation-only marker written by the VPS bootstrap; no client code can read it.
CLOUDFLARE_PROXY_ENABLED=1

# Required: MySQL-compatible database connection. URL-encode special password characters.
DATABASE_URL=mysql://wpinvoice:CHANGE_THIS_PASSWORD@127.0.0.1:3306/wpinvoice

# Required: use a 32-byte key encoded as 64 hexadecimal characters or 44-character base64.
# scripts/prepare-environment.sh generates this safely for native/Docker setups.
APP_CONFIG_ENCRYPTION_KEY=__GENERATE__
WEBHOOK_SIGNING_SECRET=__GENERATE__
RECURRING_SCHEDULER_SECRET=__GENERATE__

# Set once for a non-interactive first install, then remove after confirming administrator access.
BOOTSTRAP_ADMIN_EMAIL=admin@welfarepride.local
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-of-at-least-14-characters

# Required for company logo uploads. Use a private S3-compatible bucket.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=welfare-pride-invoices
S3_ACCESS_KEY_ID=CHANGE_THIS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_THIS_SECRET
# Leave blank to use protected, short-lived signed redirects.
S3_PUBLIC_BASE_URL=

# Optional immutable Entra configuration. These can instead be entered later in Security & access.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# Docker Compose only. MYSQL_PASSWORD must remain base64url-safe (A-Z, a-z, 0-9, _ or -)
# because Docker Compose constructs DATABASE_URL from it. The preparation script generates safe values.
MYSQL_DATABASE=wpinvoice
MYSQL_USER=wpinvoice
MYSQL_PASSWORD=__GENERATE__
# Docker deployment moves this generated value into .secrets/mysql_root_password and removes it from .env.
MYSQL_ROOT_PASSWORD=__GENERATE__
# Keep the container listener private behind the local Nginx/Cloudflare path.
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
